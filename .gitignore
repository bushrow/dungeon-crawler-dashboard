node_modules/

# Build output, except the compiled corpus. data/dist is the contract between
# the pipeline and the apps: the apps import it directly, so a fresh clone has
# to be able to build without running the Python pipeline first.
dist/
!data/dist/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# Scrape dumps stay out of the repo. No book text, ever. See docs/METHODOLOGY.md.
data/raw/
