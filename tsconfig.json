{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@dcc/core": ["./packages/core/src/index.ts"],
      "@dcc/shell": ["./apps/shell/src/index.ts"]
    }
  },
  "include": ["packages", "apps", "tests", "vite.config.ts"]
}
